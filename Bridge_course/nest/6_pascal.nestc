#include <stdio.h>
int main() {
    int n, i, j;
    long term;
    printf("Enter number of rows: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        term = 1;
        for (j = 0; j <= i; j++) {
            printf("%ld ", term);
            term = term * (i - j) / (j + 1);
        }
        printf("\n");
    }
    return 0;
}